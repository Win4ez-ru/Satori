{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:satori:schedule-import:v1",
  "title": "Reviewed portable work-shift plan",
  "description": "Interchange only. Calendar identity and one-use execution permission are selected and validated separately on each device. Runtime validation additionally checks dates, IANA offsets, durations, duplicates and the 62-day plan bound.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "time_zone", "shifts"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "time_zone": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_+./-]+$"},
    "shifts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "start", "end"],
        "properties": {
          "title": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"},
          "start": {"$ref": "#/$defs/instant"},
          "end": {"$ref": "#/$defs/instant"}
        }
      }
    }
  },
  "$defs": {
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
