      "setup": {"stance": "answer", "affect_profile": "tense_non_hostile", "direct_personal_devaluation": true, "explicit_request": true},
      "expected": {"response_act": "owned_verdict", "grounding_mode": "explicit_input_only", "acknowledgement_mode": "omit", "continuation_mode": "guarded"}
