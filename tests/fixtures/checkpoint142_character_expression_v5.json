      "expected": {"response_act": "situation_reframe", "grounding_mode": "explicit_input_only", "acknowledgement_mode": "contextual", "continuation_mode": "complete"}
    },
    {
      "id": "repeated_critical_pressure_keeps_one_guarded_act",
