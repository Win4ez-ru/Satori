# Copy to .env only when local overrides are needed.
SATORI_ENVIRONMENT=development
SATORI_DATABASE_URL=sqlite+pysqlite:///./var/satori.db
SATORI_LOG_LEVEL=INFO
SATORI_CONVERSATION_PROVIDER=ollama
SATORI_CONVERSATION_MODEL=qwen3:4b-instruct
SATORI_CONVERSATION_PROVIDER_BASE_URL=http://127.0.0.1:11434
SATORI_CONVERSATION_TIMEOUT_SECONDS=120
SATORI_CONVERSATION_TEMPERATURE=0.3
SATORI_CONVERSATION_MAX_OUTPUT_TOKENS=768
SATORI_CONVERSATION_MAX_INPUT_CHARS=8000
SATORI_CONVERSATION_MAX_CONTEXT_CHARS=12000
SATORI_CONVERSATION_MAX_RESPONSE_CHARS=12000
# Optional foreground-only Yandex AI Studio checkpoint 14.1 overrides:
# SATORI_CONVERSATION_PROVIDER=yandex_ai_studio
# SATORI_CONVERSATION_MODEL=deepseek-v4-flash
# SATORI_YANDEX_AI_STUDIO_FOLDER_ID=<folder-id>
# SATORI_YANDEX_AI_STUDIO_API_KEY=
# Optional only for a Yandex-hosted DeepSeek foreground model: low, medium or high.
# SATORI_YANDEX_AI_STUDIO_REASONING_EFFORT=low
# Credential-bearing traffic is pinned to this canonical endpoint.
SATORI_YANDEX_AI_STUDIO_BASE_URL=https://ai.api.cloud.yandex.net/v1
# Optional foreground-only OpenAI candidate from ADR-0031:
# SATORI_CONVERSATION_PROVIDER=openai
# SATORI_CONVERSATION_MODEL=gpt-5.6-terra
# SATORI_OPENAI_API_KEY=
# OpenAI Responses reasoning: none, low, medium, high, xhigh or max.
# Temperature is sent only for none; reasoning-enabled requests omit that sampling field.
SATORI_OPENAI_REASONING_EFFORT=low
# Added only to the app-visible per-turn cap when reasoning is enabled; maximum 4096.
SATORI_OPENAI_REASONING_TOKEN_ALLOWANCE=1024
# Credential-bearing traffic is pinned to this canonical endpoint.
SATORI_OPENAI_BASE_URL=https://api.openai.com/v1
SATORI_RECENT_CONVERSATION_MAX_TURNS=8
SATORI_RECENT_CONVERSATION_MAX_CHARS=6000
SATORI_OLLAMA_KEEP_ALIVE=10m
SATORI_OLLAMA_SERIALIZE_INFERENCE=true
SATORI_OLLAMA_BACKGROUND_AGING_SECONDS=30
SATORI_OLLAMA_BACKGROUND_GRACE_SECONDS=2
SATORI_EPISODE_FORMATION_PROVIDER=ollama
SATORI_EPISODE_FORMATION_MODEL=qwen3:4b-instruct
SATORI_EPISODE_FORMATION_MAX_OUTPUT_TOKENS=512
SATORI_SEMANTIC_FORMATION_PROVIDER=ollama
SATORI_SEMANTIC_FORMATION_MODEL=qwen3:4b-instruct
SATORI_SEMANTIC_FORMATION_MAX_OUTPUT_TOKENS=768
SATORI_MODEL_FORMATION_PROVIDER=ollama
SATORI_MODEL_FORMATION_MODEL=qwen3:4b-instruct
SATORI_MODEL_FORMATION_MAX_OUTPUT_TOKENS=512
SATORI_MODEL_FORMATION_MAX_SOURCE_MESSAGES=8
SATORI_MODEL_FORMATION_MAX_USER_CLAIMS=2
SATORI_MODEL_FORMATION_MAX_WORLD_CLAIMS=2
SATORI_MODEL_BACKFILL_LIMIT=100
SATORI_POSITION_FORMATION_PROVIDER=ollama
SATORI_POSITION_FORMATION_MODEL=qwen3:4b-instruct
SATORI_POSITION_FORMATION_MAX_OUTPUT_TOKENS=640
SATORI_POSITION_FORMATION_MAX_SOURCE_MESSAGES=8
SATORI_POSITION_FORMATION_MAX_POSITIONS=3
SATORI_POSITION_BACKFILL_LIMIT=100
SATORI_POSITION_CONTEXT_TOP_K=4
SATORI_POSITION_CONTEXT_MAX_CHARS=1600
SATORI_REFLECTION_PROVIDER=ollama
SATORI_REFLECTION_MODEL=qwen3:4b-instruct
SATORI_REFLECTION_PROVIDER_BASE_URL=http://127.0.0.1:11434
SATORI_REFLECTION_TIMEOUT_SECONDS=180
SATORI_REFLECTION_MAX_OUTPUT_TOKENS=768
SATORI_AFFECTIVE_APPRAISAL_PROVIDER=ollama
SATORI_AFFECTIVE_APPRAISAL_MODEL=qwen3:4b-instruct
SATORI_AFFECTIVE_APPRAISAL_PROVIDER_BASE_URL=http://127.0.0.1:11434
SATORI_AFFECTIVE_APPRAISAL_TIMEOUT_SECONDS=120
SATORI_AFFECTIVE_APPRAISAL_MAX_OUTPUT_TOKENS=96
SATORI_AFFECTIVE_APPRAISAL_CONTEXT_WINDOW=4096
SATORI_RELATIONSHIP_APPRAISAL_PROVIDER=ollama
SATORI_RELATIONSHIP_APPRAISAL_MODEL=qwen3:4b-instruct
SATORI_RELATIONSHIP_APPRAISAL_PROVIDER_BASE_URL=http://127.0.0.1:11434
SATORI_RELATIONSHIP_APPRAISAL_TIMEOUT_SECONDS=120
SATORI_RELATIONSHIP_APPRAISAL_MAX_OUTPUT_TOKENS=64
SATORI_RELATIONSHIP_APPRAISAL_CONTEXT_WINDOW=4096
SATORI_DEFAULT_COUNTERPARTY_ID=local-default
SATORI_SEMANTIC_MAX_CLAIMS_PER_MEMORY=4
SATORI_SEMANTIC_MAX_SOURCE_MEMORIES=6
SATORI_SEMANTIC_BACKFILL_LIMIT=100
SATORI_SEMANTIC_RETRIEVAL_TOP_K=4
SATORI_SEMANTIC_RETRIEVAL_MAX_CONTEXT_CHARS=2000
SATORI_EMBEDDING_PROVIDER=ollama
SATORI_EMBEDDING_MODEL=embeddinggemma:300m
SATORI_EMBEDDING_PROVIDER_BASE_URL=http://127.0.0.1:11434
SATORI_EMBEDDING_DIMENSIONS=768
SATORI_EMBEDDING_TIMEOUT_SECONDS=120
SATORI_RETRIEVAL_MINIMUM_SIMILARITY=0.55
SATORI_RETRIEVAL_CANDIDATE_LIMIT=32
SATORI_RETRIEVAL_TOP_K=4
SATORI_RETRIEVAL_MAX_CONTEXT_CHARS=2400
SATORI_RETRIEVAL_SEMANTIC_WEIGHT=0.80
SATORI_RETRIEVAL_IMPORTANCE_WEIGHT=0.10
SATORI_RETRIEVAL_RECENCY_WEIGHT=0.10
SATORI_RETRIEVAL_RECENCY_HALF_LIFE_DAYS=30
SATORI_CHAT_LOG_PATH=./var/satori-runtime.jsonl
